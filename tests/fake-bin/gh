#!/usr/bin/env bash
# Fake gh for the pr_status.sh tests. Output and exit status are set through environment variables.
#   FAKE_GRAPHQL       file printed to stdout by gh api graphql
#   FAKE_GRAPHQL_ERR   stderr of gh api graphql (when FAKE_GRAPHQL_RC is non-zero)
#   FAKE_GRAPHQL_RC    exit status of gh api graphql (when non-zero, FAKE_GRAPHQL is not printed)
#   FAKE_CHECKS_OUT    stdout of gh pr checks
#   FAKE_CHECKS_ERR    stderr of gh pr checks
#   FAKE_CHECKS_RC     exit status of gh pr checks
#   FAKE_REST_DIR      directory holding the responses for gh api <path> (REST). Prints the file named
#                      after the path without its query string, with / replaced by _ and .json appended
#                      (e.g. repos/o/r/pulls/1/reviews?per_page=100 → repos_o_r_pulls_1_reviews.json).
#                      If the file does not exist, exits with status 1 as HTTP 404
#   FAKE_GH_LOG        if set, append the arguments of each call as one line
if [ -n "${FAKE_GH_LOG:-}" ]; then
  echo "$*" >>"$FAKE_GH_LOG"
fi
case "$1 ${2:-}" in
  "api graphql")
    if [ "${FAKE_GRAPHQL_RC:-0}" -ne 0 ]; then
      printf '%s' "${FAKE_GRAPHQL_ERR:-}" >&2
      exit "$FAKE_GRAPHQL_RC"
    fi
    cat "$FAKE_GRAPHQL"
    ;;
  "pr checks")
    printf '%s' "${FAKE_CHECKS_OUT:-}"
    printf '%s' "${FAKE_CHECKS_ERR:-}" >&2
    exit "${FAKE_CHECKS_RC:-0}"
    ;;
  api\ *)
    # Skip options such as --paginate and treat the first argument as the path
    shift
    path=""
    for arg in "$@"; do
      case "$arg" in
        -*) ;;
        *) path="$arg"; break ;;
      esac
    done
    file="${FAKE_REST_DIR:-/nonexistent}/$(printf '%s' "${path%%\?*}" | tr / _).json"
    if [ ! -f "$file" ]; then
      echo "gh: Not Found (HTTP 404)" >&2
      exit 1
    fi
    cat "$file"
    ;;
  *)
    echo "fake gh: unexpected call: $*" >&2
    exit 99
    ;;
esac
